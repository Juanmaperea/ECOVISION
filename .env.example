# Backend
APP_NAME=EcoVision AI
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Vision
YOLO_MODEL_PATH=backend/models/yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.50
FRAME_PROCESS_INTERVAL_MS=1000

# LLM
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Privacy / logging
STORE_IMAGES=false
LOG_LEVEL=INFO
